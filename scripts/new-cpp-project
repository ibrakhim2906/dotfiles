#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  echo "Usage: new-cpp-project <name>"
  echo "Creates and configures a C++20/CMake project in ~/projects/<name>."
  exit 0
fi
if [ "$#" -ne 1 ]; then
  echo "Usage: new-cpp-project <name>"
  exit 1
fi

NAME="$1"
if ! [[ "$NAME" =~ ^[A-Za-z][A-Za-z0-9]*([_-][A-Za-z0-9]+)*$ ]]; then
  echo "Error: use a letter first, then letters/digits separated by single _ or - characters."
  exit 1
fi

DIR="$HOME/projects/$NAME"
PKG=$(echo "$NAME" | tr '[:upper:]_' '[:lower:]-')
case "$PKG" in
  core|default|prn|aux|nul|con|com[0-9]|lpt[0-9])
    echo "Error: '$NAME' is a reserved package name. Choose another name."
    exit 1
    ;;
esac
# A prefix also makes C++ keyword names such as 'class' safe.
PKG_NS="project_${PKG//-/_}"

export VCPKG_ROOT="${VCPKG_ROOT:-$HOME/vcpkg}"
if [ ! -x "$VCPKG_ROOT/vcpkg" ]; then
  echo "Error: vcpkg not found at $VCPKG_ROOT"
  echo "  git clone https://github.com/microsoft/vcpkg.git ~/vcpkg && ~/vcpkg/bootstrap-vcpkg.sh"
  exit 1
fi
for tool in cmake ninja git g++; do
  command -v "$tool" >/dev/null || { echo "Error: $tool is not installed"; exit 1; }
done
CMAKE_VER=$(cmake --version | head -n1 | awk '{print $3}')
if [ "$(printf '%s\n3.25\n' "$CMAKE_VER" | sort -V | head -n1)" != "3.25" ]; then
  echo "Error: CMake $CMAKE_VER found; CMake >= 3.25 is required."
  exit 1
fi

if [ -e "$DIR" ]; then
  echo "Error: $DIR already exists"
  exit 1
fi

mkdir -p "$DIR"/{src,tests,bench,include/"$PKG"}
cd "$DIR"

# =============================================================== CMakeLists
cat > CMakeLists.txt << EOF_CMAKE
cmake_minimum_required(VERSION 3.25)
# Resolve vcpkg before project() enables the compiler. Works in IDEs as well
# as terminals, with VCPKG_ROOT as an optional override.
if(NOT DEFINED CMAKE_TOOLCHAIN_FILE)
  if(DEFINED ENV{VCPKG_ROOT} AND NOT "\$ENV{VCPKG_ROOT}" STREQUAL "")
    set(_vcpkg_root "\$ENV{VCPKG_ROOT}")
  else()
    set(_vcpkg_root "\$ENV{HOME}/vcpkg")
  endif()
  set(CMAKE_TOOLCHAIN_FILE "\${_vcpkg_root}/scripts/buildsystems/vcpkg.cmake"
      CACHE FILEPATH "vcpkg toolchain")
endif()

project(${NAME} CXX)

enable_testing()

# Use ccache automatically if it is installed (no machine paths in presets).
find_program(CCACHE_PROGRAM ccache)
if(CCACHE_PROGRAM AND NOT CMAKE_CXX_COMPILER_LAUNCHER)
  set(CMAKE_CXX_COMPILER_LAUNCHER "\${CCACHE_PROGRAM}")
endif()

string(TOUPPER "\${CMAKE_BUILD_TYPE}" _bt)
message(STATUS "CXX flags: \${CMAKE_CXX_FLAGS} \${CMAKE_CXX_FLAGS_\${_bt}}")

# ---- core library: all real code lives here so tests and benches can link it
add_library(${PKG}_core STATIC src/placeholder.cpp)
target_include_directories(${PKG}_core PUBLIC include)
target_compile_features(${PKG}_core PUBLIC cxx_std_20)
target_compile_options(${PKG}_core PRIVATE -Wall -Wextra -Wpedantic -Werror)

# ---- ADDING DEPENDENCIES (see README.md for the full decision table)
# 1) vcpkg (preferred):   ./run.sh add fmt
#      find_package(fmt CONFIG REQUIRED)
#      target_link_libraries(${PKG}_core PUBLIC fmt::fmt)
# 2) FetchContent (not in vcpkg / want an exact git tag):
#      include(FetchContent)
#      FetchContent_Declare(foo GIT_REPOSITORY <url> GIT_TAG <tag>)
#      FetchContent_MakeAvailable(foo)
#      target_link_libraries(${PKG}_core PUBLIC foo::foo)
# Link to the CORE library: app, tests and bench inherit it automatically.

# ---- driver
add_executable(app src/main.cpp)
target_link_libraries(app PRIVATE ${PKG}_core)

# ---- tests
find_package(GTest CONFIG REQUIRED)
add_executable(tests tests/test_main.cpp)
target_link_libraries(tests PRIVATE ${PKG}_core GTest::gtest GTest::gtest_main)
include(GoogleTest)
gtest_discover_tests(tests)

# ---- benchmarks
find_package(benchmark CONFIG REQUIRED)
add_executable(bench bench/bench_main.cpp)
target_link_libraries(bench PRIVATE ${PKG}_core benchmark::benchmark)
EOF_CMAKE

# ================================================================ vcpkg.json
BASELINE=""
if git -C "$VCPKG_ROOT" rev-parse HEAD >/dev/null 2>&1; then
  BASELINE=",
  \"builtin-baseline\": \"$(git -C "$VCPKG_ROOT" rev-parse HEAD)\""
fi
cat > vcpkg.json << EOF_VCPKG
{
  "name": "${PKG}",
  "version": "0.1.0",
  "dependencies": ["gtest", "benchmark"]${BASELINE}
}
EOF_VCPKG

cat > CMakePresets.json << 'EOF_PRESETS'
{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "dev (debug, no sanitizers)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g3 -fno-omit-frame-pointer"
      }
    },
    {
      "name": "asan",
      "displayName": "asan + ubsan",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "tsan",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=thread -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "release",
      "displayName": "release (benchmarks)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -march=native -g -DNDEBUG"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",     "configurePreset": "dev" },
    { "name": "asan",    "configurePreset": "asan" },
    { "name": "tsan",    "configurePreset": "tsan" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "dev",  "configurePreset": "dev",  "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    { "name": "dev", "steps": [
      { "type": "configure", "name": "dev" },
      { "type": "build",     "name": "dev" },
      { "type": "test",      "name": "dev" } ] },
    { "name": "asan", "steps": [
      { "type": "configure", "name": "asan" },
      { "type": "build",     "name": "asan" },
      { "type": "test",      "name": "asan" } ] },
    { "name": "tsan", "steps": [
      { "type": "configure", "name": "tsan" },
      { "type": "build",     "name": "tsan" },
      { "type": "test",      "name": "tsan" } ] },
    { "name": "release", "steps": [
      { "type": "configure", "name": "release" },
      { "type": "build",     "name": "release" } ] }
  ]
}
EOF_PRESETS

# ===================================================================== run.sh
cat > run.sh << 'EOF_RUN'
#!/usr/bin/env bash
# ./run.sh <command>      (default: dev)
#
#   dev | asan | tsan   configure + build + ctest with that preset
#   test                alias for asan
#   setup               configure dev only (creates compile_commands.json for clangd)
#   build               configure dev and build the app
#   run [args...]       build dev and run the app
#   bench               release build, then run benchmarks
#   all                 test + bench
#   add <port>...       add a vcpkg dependency to vcpkg.json
#   usage <port>        show the find_package/link lines vcpkg suggests (after configure)
#   clean               delete build directories (keeps vcpkg_installed)
#   help                show these commands
#
# These are thin wrappers: the same thing works in any IDE or CI via
#   cmake --workflow --preset <name>
set -euo pipefail
cd "$(dirname "$0")"

export VCPKG_ROOT="${VCPKG_ROOT:-$HOME/vcpkg}"

cmd="${1:-dev}"
if [ $# -gt 0 ]; then shift; fi

case "$cmd" in
  dev|asan|tsan)
    cmake --workflow --preset "$cmd"
    ;;
  test)
    cmake --workflow --preset asan
    ;;
  setup)
    cmake --preset dev
    ;;
  build|run)
    # Ninja reconfigures when CMakeLists or vcpkg manifests change. Preset
    # files need an explicit configure; ordinary source edits only need a build.
    if [[ ! -f build-dev/build.ninja ||
          CMakePresets.json -nt build-dev/build.ninja ||
          CMakeUserPresets.json -nt build-dev/build.ninja ]]; then
      cmake --preset dev
    fi
    cmake --build --preset dev --target app
    if [ "$cmd" = run ]; then ./build-dev/app "$@"; fi
    ;;
  bench)
    cmake --workflow --preset release
    ./build-release/bench "$@"
    ;;
  all)
    ./run.sh test && ./run.sh bench
    ;;
  add)
    [ $# -ge 1 ] || { echo "usage: run.sh add <vcpkg-port>..."; exit 1; }
    for port in "$@"; do "$VCPKG_ROOT/vcpkg" add port "$port"; done
    echo
    echo "Next: run ./run.sh setup, then ./run.sh usage <port> for the CMake lines."
    ;;
  usage)
    [ $# -ge 1 ] || { echo "usage: run.sh usage <vcpkg-port>"; exit 1; }
    shopt -s nullglob
    files=(vcpkg_installed/*/share/"$1"/usage)
    if [ ${#files[@]} -eq 0 ]; then
      echo "No usage file for '$1' (run ./run.sh setup first, or look it up at vcpkg.io)."
      exit 1
    fi
    cat "${files[0]}"
    ;;
  clean)
    rm -rf build-dev build-asan build-tsan build-release
    ;;
  help|-h|--help)
    sed -n '2,/^set -/{ /^set -/d; s/^# *//; p; }' ./run.sh
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    ./run.sh help >&2
    exit 1
    ;;
esac
EOF_RUN
chmod +x run.sh

# =============================================================== VS Code / WSL
mkdir -p .vscode
cat > .vscode/settings.json << 'EOF_VSCODE_SETTINGS'
{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "clangd.path": "/usr/bin/clangd",
  "C_Cpp.intelliSenseEngine": "disabled",
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  }
}
EOF_VSCODE_SETTINGS

cat > .vscode/tasks.json << 'EOF_VSCODE_TASKS'
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/run.sh",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "C++: test (dev)",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/run.sh",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "test"
    },
    {
      "label": "C++: test (ASan + UBSan)",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/run.sh",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "test"
    }
  ]
}
EOF_VSCODE_TASKS

cat > .vscode/launch.json << 'EOF_VSCODE_LAUNCH'
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug app",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-dev/app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "preLaunchTask": "C++: build"
    }
  ]
}
EOF_VSCODE_LAUNCH

cat > .vscode/extensions.json << 'EOF_VSCODE_EXTENSIONS'
{
  "recommendations": [
    "llvm-vs-code-extensions.vscode-clangd",
    "ms-vscode.cmake-tools",
    "vadimcn.vscode-lldb"
  ]
}
EOF_VSCODE_EXTENSIONS

# =============================================================== tool configs
cat > .clangd << 'EOF_CLANGD'
CompileFlags:
  CompilationDatabase: build-dev
EOF_CLANGD

cat > .clang-tidy << 'EOF_TIDY'
Checks: >
  -*,
  performance-*,
  bugprone-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  readability-identifier-naming
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
EOF_TIDY

# Share the portable VS Code shortcuts; keep personal IDE state local.
cat > .gitignore << 'EOF_IGNORE'
build-dev/
build-release/
build-asan/
build-tsan/
cmake-build-*/
vcpkg_installed/
.cache/
.idea/
.vscode/*
